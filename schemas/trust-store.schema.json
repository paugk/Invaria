{
  "$defs": {
    "KeyRevocation": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "superseded",
            "key_compromise"
          ],
          "title": "Reason",
          "type": "string"
        },
        "revoked_at": {
          "format": "date-time",
          "title": "Revoked At",
          "type": "string"
        }
      },
      "required": [
        "revoked_at",
        "reason"
      ],
      "title": "KeyRevocation",
      "type": "object"
    },
    "TrustedKey": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Key Id",
          "type": "string"
        },
        "public_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Public Key",
          "type": "string"
        },
        "purposes": {
          "items": {
            "const": "bundle_signing",
            "type": "string"
          },
          "minItems": 1,
          "title": "Purposes",
          "type": "array"
        },
        "revocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyRevocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valid To"
        }
      },
      "required": [
        "key_id",
        "algorithm",
        "public_key",
        "purposes",
        "valid_from",
        "valid_to",
        "revocation"
      ],
      "title": "TrustedKey",
      "type": "object"
    }
  },
  "$id": "urn:invaria:schema:trust-store:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Keys a verifier trusts, supplied by the verifier, never taken from the bundle.",
  "properties": {
    "keys": {
      "items": {
        "$ref": "#/$defs/TrustedKey"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Keys",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "store_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Store Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "store_id",
    "keys"
  ],
  "title": "TrustStore",
  "type": "object"
}
