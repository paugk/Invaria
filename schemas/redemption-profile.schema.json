    "SourceAuthority": {
      "additionalProperties": false,
      "description": "Authority is per fact type. No source is a universal source of truth.\n\n``mapping_ref`` is the mapping of the source's authoritative records;\n``additional_mapping_refs`` (fund-subscription-testnet@1.4.0 on) are the other mappings\nthe profile admits for this source (a chain source also writes chain effects and the\nmovements only one route reads). A new evaluation is refused when an observation of a\ndeclared source was produced by a mapping the profile does not admit for it: it is\nnever relabelled nor read as if another mapping had produced it. Absent,\nthe source admits only ``mapping_ref``; it is omitted when serialized, so existing\nprofiles stay byte-identical.",
      "properties": {
        "additional_mapping_refs": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Additional Mapping Refs"
        },
        "authoritative_for": {
          "items": {
            "enum": [
              "order_accepted",
              "cash_settled",
              "units_registered",
              "token_movement",
              "redemption_accepted",
              "redemption_cancelled",
              "position_held",
              "price_approved",
              "position_changed",
              "redemption_reactivated",
              "chain_effect"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Authoritative For",
          "type": "array"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "order_management",
            "bank",
            "transfer_agent",
            "stellar_ledger",
            "pricing_agent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mapping_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Mapping Ref",
          "type": "string"
        },
        "parser_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Parser Ref",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "kind",
        "authoritative_for",
        "mapping_ref",
        "parser_ref",
        "description"
      ],
      "title": "SourceAuthority",
      "type": "object"
    },
    "StellarClassicRepresentation": {
      "additionalProperties": false,
      "description": "A Stellar Classic asset: network + asset code + issuer.\n\nClassic amounts carry 7 decimals. Access through the Stellar Asset Contract (SAC) is\nthe same underlying asset and must never be counted as a second issuance; the\nfirst synthetic profile does not ingest SAC events at all (declared unsupported).",
      "properties": {
        "amount_scale": {
          "const": 7,
          "title": "Amount Scale",
          "type": "integer"
        },
        "asset_code": {
          "pattern": "^[A-Za-z0-9]{1,12}$",
          "title": "Asset Code",
          "type": "string"
        },
        "instrument_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "issuer": {
          "title": "Issuer",
          "type": "string"
        },
        "network": {
          "enum": [
            "stellar:testnet",
            "stellar:pubnet"
          ],
          "title": "Network",
          "type": "string"
        },
        "network_passphrase": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Network Passphrase",
          "type": "string"
        },
        "representation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Representation Id",
          "type": "string"
        },
        "standard": {
          "const": "stellar_classic",
          "title": "Standard",
          "type": "string"
        }
      },
      "required": [
        "representation_id",
        "instrument_id",
        "standard",
        "network",
        "network_passphrase",
        "asset_code",
        "issuer",
        "amount_scale"
      ],
      "title": "StellarClassicRepresentation",
      "type": "object"
    },
    "TaJournal": {
      "additionalProperties": false,
      "description": "The TA journal whose source-assigned sequence orders acceptance, positions and\ntheir changes. A guarantee of this synthetic fixture, not of future real sources.",
      "properties": {
        "journal_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Journal Id",
          "type": "string"
        },
        "ordering": {
          "const": "source_assigned_strict_total_order",
          "title": "Ordering",
          "type": "string"
        },
        "position_semantics": {
          "const": "state_after_its_sequence",
          "title": "Position Semantics",
          "type": "string"
        },
        "scope": {
          "const": "synthetic_demo_a_only",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "journal_id",
        "ordering",
        "position_semantics",
        "scope"
      ],
      "title": "TaJournal",
      "type": "object"
    }
  },
  "$id": "urn:invaria:schema:redemption-profile:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What a redemption must show, from whom, and how it is judged.",
  "properties": {
