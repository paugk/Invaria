        },
        "control_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "incidents": {
          "title": "Incidents",
          "type": "integer"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "oldest_age_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Oldest Age Seconds"
        },
        "operations": {
          "title": "Operations",
          "type": "integer"
        },
        "profile_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
