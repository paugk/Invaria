            },
            {
              "type": "null"
            }
          ],
          "title": "Profile Ref"
        },
        "published_history": {
          "items": {
            "$ref": "#/$defs/PublishedRef"
          },
          "title": "Published History",
          "type": "array"
        },
        "scope_epoch": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope Epoch"
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelectedEvaluation"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "admitted",
            "published_after_cut",
            "engine_not_admissible",
            "engine_retired_requires_reevaluation",
            "stale_publication",
            "stored_not_published",
            "registered_not_evaluated",
            "unregistered"
