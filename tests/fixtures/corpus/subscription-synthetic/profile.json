  "correlation": {
    "operation_key": "order_ref",
    "institutional_link": "operation_ref_equals_order_ref",
    "chain_link": "explicit_execution_link_only",
    "account_link": "approved_identity_link"
  },
  "sources": [
    {
      "source_id": "oms-synthetic",
      "kind": "order_management",
      "authoritative_for": [
        "order_accepted"
      ],
      "mapping_ref": "oms-csv-synthetic@1.0.0",
      "parser_ref": "csv-synthetic-parser@1.0.0",
      "description": "Order book export: accepted subscription orders and their terms."
    },
    {
      "source_id": "bank-synthetic",
      "kind": "bank",
      "authoritative_for": [
        "cash_settled"
      ],
      "mapping_ref": "bank-csv-synthetic@1.0.0",
      "parser_ref": "csv-synthetic-parser@1.0.0",
      "description": "Bank statement export: settled cash per payment, with revisions."
    },
    {
      "source_id": "ta-synthetic",
      "kind": "transfer_agent",
      "authoritative_for": [
        "units_registered"
      ],
      "mapping_ref": "ta-csv-synthetic@1.0.0",
      "parser_ref": "csv-synthetic-parser@1.0.0",
      "description": "Transfer agent register export: units registered per order."
    },
    {
      "source_id": "stellar-testnet-frozen",
      "kind": "stellar_ledger",
      "authoritative_for": [
        "token_movement"
      ],
      "mapping_ref": "stellar-frozen-synthetic@1.0.0",
      "parser_ref": "stellar-frozen-parser@1.0.0",
      "description": "Frozen synthetic Stellar testnet payments of DEMOA. Authoritative only for technical execution on-chain, not for registry or cash."
    }
  ],
  "coverage_requirements": [
    {
      "source_id": "oms-synthetic",
      "fact_types": [
        "order_accepted"
      ],
      "min_level": "internally_checked",
      "must_cover": "order_valid_time_to_valid_at",
      "gaps_allowed": false,
      "quarantined_records_allowed": false
    },
    {
      "source_id": "bank-synthetic",
      "fact_types": [
        "cash_settled"
      ],
      "min_level": "internally_checked",
      "must_cover": "order_valid_time_to_valid_at",
      "gaps_allowed": false,
      "quarantined_records_allowed": false
    },
    {
      "source_id": "ta-synthetic",
      "fact_types": [
        "units_registered"
      ],
      "min_level": "internally_checked",
      "must_cover": "order_valid_time_to_valid_at",
      "gaps_allowed": false,
      "quarantined_records_allowed": false
    },
    {
      "source_id": "stellar-testnet-frozen",
      "fact_types": [
        "token_movement"
      ],
      "min_level": "internally_checked",
      "must_cover": "order_valid_time_to_valid_at",
      "gaps_allowed": false,
      "quarantined_records_allowed": false
    }
  ],
  "controls": [
    {
      "control_id": "subscription.order_terms",
      "mandatory": true,
      "requires": [
        "order_accepted"
      ],
      "comparison": "exact_equal",
      "left": "order.units x pricing.price_per_unit (exact, converted to cash scale)",
      "right": "order.cash_amount",
      "failure_code": "ORDER_TERMS_INCONSISTENT",
      "when_missing": "UNKNOWN",
      "on_conflict": "UNKNOWN",
      "on_unsupported": "UNKNOWN"
    },
    {
      "control_id": "subscription.cash_vs_order",
      "mandatory": true,
      "requires": [
        "order_accepted",
        "cash_settled"
      ],
      "comparison": "exact_equal",
      "left": "current cash_settled.amount for the order (latest revision known at snapshot)",
      "right": "order.cash_amount",
      "failure_code": "CASH_AMOUNT_MISMATCH",
      "when_missing": "UNKNOWN",
      "on_conflict": "UNKNOWN",
      "on_unsupported": "UNKNOWN"
    },
    {
      "control_id": "subscription.ta_units_vs_order",
      "mandatory": true,
      "requires": [
        "order_accepted",
        "units_registered"
      ],
      "comparison": "exact_equal",
      "left": "units_registered.units for the order",
      "right": "order.units",
      "failure_code": "UNITS_MISMATCH",
      "when_missing": "UNKNOWN",
      "on_conflict": "UNKNOWN",
      "on_unsupported": "UNKNOWN"
    },
    {
      "control_id": "subscription.token_units_vs_order",
      "mandatory": true,
      "requires": [
        "order_accepted",
        "token_movement"
      ],
      "comparison": "exact_equal",
      "left": "sum of distinct successful issuer->investor movements explicitly linked to the order, to an address with an approved identity link",
      "right": "order.units",
      "failure_code": "UNITS_MISMATCH",
      "when_missing": "UNKNOWN",
      "on_conflict": "UNKNOWN",
      "on_unsupported": "UNKNOWN"
    }
  ],
  "rules_ref": "subscription-synthetic-rules@1.0.0",
  "result_precedence": "BREAK>UNKNOWN>MATCH",
  "evidence_policy": {
    "absent": "UNKNOWN",
    "conflicting_authoritative": "UNKNOWN",
    "correction": "latest_revision_known_at_snapshot",
    "retraction_without_replacement": "UNKNOWN_LOSS_OF_SUPPORT",
    "duplicate_same_content": "single_effect",
    "duplicate_different_content": "SOURCE_CONFLICT",
    "failed_chain_transaction": "no_economic_effect",
    "technical_error": "UNKNOWN"
  },
  "unsupported": [
    "fees",
