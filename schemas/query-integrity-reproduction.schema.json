{
  "$id": "urn:invaria:schema:query-integrity-reproduction:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checked_evaluations": {
      "title": "Checked Evaluations",
      "type": "integer"
    },
    "checked_publications": {
      "title": "Checked Publications",
      "type": "integer"
    },
    "differences": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Differences",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "report_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "REPRODUCED",
        "MISMATCH"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "report_sha256",
    "status",
    "checked_evaluations",
    "checked_publications",
    "differences",
    "limitations"
  ],
  "title": "ReproductionView",
  "type": "object"
}
