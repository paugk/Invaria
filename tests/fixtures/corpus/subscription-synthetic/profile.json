      "standard": "stellar_classic",
      "network": "stellar:testnet",
      "network_passphrase": "Test SDF Network ; September 2015",
      "asset_code": "DEMOA",
      "issuer": "GDMYHWUG6BLHEGQSTMCAGUFUZFRZ6XGXJSHDKMDUZ6IRCKJ4FGZCCZVZ",
      "amount_scale": 7
    }
  ],
  "representation_ratio": "1:1",
  "pricing": {
    "cash_unit": "USD",
    "cash_scale": 2,
