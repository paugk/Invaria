  "$id": "urn:invaria:schema:query-integrity-report:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Reproducible operational integrity report. Not a verified financial bundle.\n\n``report_sha256`` is computed over this same content: it detects edits made without a\nnew hash, but it does not authenticate the issuer, and anyone can edit the report and\nrecompute it. Access never comes from the file: details and reproduction re-check every\nreference against the store of the authenticated scope.",
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "blockers": {
      "$ref": "#/$defs/BlockersView"
    },
    "definition": {
      "enum": [
        "integrity-analytics@1.0.0",
        "integrity-analytics@1.1.0"
      ],
      "title": "Definition",
      "type": "string"
    },
    "diagnostic_engines": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
        "type": "string"
      },
      "title": "Diagnostic Engines",
      "type": "array"
    },
    "discrepancies": {
      "$ref": "#/$defs/DiscrepanciesView"
    },
    "distribution": {
      "$ref": "#/$defs/DistributionView"
    },
    "exclusions": {
      "items": {
        "$ref": "#/$defs/ExclusionView"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "max_replays": {
      "title": "Max Replays",
      "type": "integer"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/IntegrityMember"
      },
      "title": "Members",
      "type": "array"
    },
    "profile_filter": {
      "anyOf": [
        {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Profile Filter"
    },
    "report_format": {
      "enum": [
        "invaria-integrity-report@1.0",
        "invaria-integrity-report@1.1"
      ],
      "title": "Report Format",
      "type": "string"
    },
    "report_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ReportScopeView"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/SegmentView"
      },
      "title": "Segments",
      "type": "array"
    },
    "selection_description": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Selection Description",
      "type": "string"
    },
    "selection_policy": {
      "enum": [
        "current-publication@1",
        "current-publication@2"
      ],
      "title": "Selection Policy",
      "type": "string"
    },
    "store_read": {
      "$ref": "#/$defs/StoreReadView"
    },
    "temporal": {
      "anyOf": [
        {
          "$ref": "#/$defs/TemporalView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "report_format",
    "definition",
    "selection_policy",
    "selection_description",
    "scope",
    "as_of",
    "store_read",
    "profile_filter",
    "max_replays",
    "diagnostic_engines",
    "members",
    "distribution",
    "segments",
    "discrepancies",
    "blockers",
    "exclusions",
    "limitations",
    "report_sha256"
  ],
  "title": "IntegrityReport",
  "type": "object"
}
