  "controls": [
    {
      "control_id": "redemption.declared_due_consistency",
      "mandatory": true,
      "requires": [
        "redemption_accepted"
      ],
      "comparison": "data_consistency",
      "applies": "always",
      "coverage": "positive_evidence_only",
      "left": "payment_due_at declared by the TA",
      "right": "accepted_at + 48 exact hours (profile)",
      "failure_codes": []
    },
    {
      "control_id": "redemption.price_vs_approved",
      "mandatory": true,
      "requires": [
        "redemption_accepted",
        "price_approved"
      ],
      "comparison": "exact_equal",
      "applies": "always",
      "coverage": "positive_evidence_only",
      "left": "price_per_unit stated in the request",
      "right": "approved price for the request's price_ref",
      "failure_codes": [
        "PRICE_MISMATCH"
      ]
    },
    {
      "control_id": "redemption.units_within_position",
      "mandatory": true,
      "requires": [
        "redemption_accepted",
        "position_held",
        "position_changed"
      ],
      "comparison": "at_most",
      "applies": "always",
      "coverage": "reconstruction_interval",
      "left": "units requested",
      "right": "available immediately before acceptance (holding - reservations, by TA sequence)",
      "failure_codes": [
        "UNITS_EXCEED_POSITION"
      ]
    },
    {
      "control_id": "redemption.cash_vs_expected",
      "mandatory": true,
      "requires": [
        "redemption_accepted",
        "price_approved",
        "cash_settled"
      ],
      "comparison": "exact_equal",
      "applies": "unless_cancelled",
      "coverage": "positive_evidence_only",
      "left": "cash paid by the bank to the requesting account",
      "right": "units requested x approved price",
      "failure_codes": [
        "CASH_AMOUNT_MISMATCH",
        "PAYMENT_TO_WRONG_ACCOUNT"
      ]
    },
    {
      "control_id": "redemption.payment_deadline",
      "mandatory": true,
      "requires": [
        "redemption_accepted",
        "cash_settled"
      ],
      "comparison": "deadline",
      "applies": "unless_cancelled",
      "coverage": "absence_interval",
      "left": "effective time of the payment",
      "right": "accepted_at + 48 exact hours (computed)",
      "failure_codes": [
        "PAYMENT_LATE",
        "PAYMENT_MISSED"
      ]
    },
    {
      "control_id": "redemption.ta_units_vs_request",
      "mandatory": true,
      "requires": [
        "redemption_accepted",
        "units_registered"
      ],
      "comparison": "exact_equal",
      "applies": "unless_cancelled",
      "coverage": "positive_evidence_only",
      "left": "units debited in the TA register",
      "right": "units requested",
      "failure_codes": [
        "UNITS_MISMATCH"
      ]
    },
    {
      "control_id": "redemption.burn_vs_request",
      "mandatory": true,
      "requires": [
        "redemption_accepted",
        "token_movement"
      ],
      "comparison": "exact_equal",
      "applies": "unless_cancelled",
      "coverage": "positive_evidence_only",
      "left": "units burned (payments to the issuer) after acceptance, linked to the request",
      "right": "units requested",
      "failure_codes": [
        "UNITS_MISMATCH"
      ]
    },
    {
      "control_id": "redemption.cancellation_valid",
      "mandatory": true,
      "requires": [
        "redemption_accepted",
        "redemption_cancelled",
        "redemption_reactivated"
      ],
      "comparison": "validity",
      "applies": "cancellation",
      "coverage": "absence_interval",
      "left": "cancellation in force",
      "right": "authority, effective time and account of the profile",
      "failure_codes": []
    },
    {
      "control_id": "redemption.no_settlement_after_cancellation",
      "mandatory": true,
      "requires": [
        "redemption_accepted",
        "redemption_cancelled",
        "cash_settled",
        "token_movement"
      ],
      "comparison": "no_settlement",
      "applies": "cancellation",
      "coverage": "absence_interval",
      "left": "payments and burns linked to the cancelled request",
      "right": "none, with bank and chain coverage",
      "failure_codes": [
        "SETTLED_DESPITE_CANCELLATION"
      ]
    }
  ],
