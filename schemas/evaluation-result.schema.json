{
  "$defs": {
    "ControlResult": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Evidence Refs",
          "type": "array"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "EXACT_MATCH",
            "CASH_AMOUNT_MISMATCH",
            "UNITS_MISMATCH",
            "ORDER_TERMS_INCONSISTENT",
            "MISSING_EVIDENCE",
            "INSUFFICIENT_COVERAGE",
            "LOSS_OF_SUPPORT",
            "SOURCE_CONFLICT",
            "AMBIGUOUS_MATCH",
            "QUARANTINED_INPUT",
            "UNSUPPORTED_CAPABILITY",
            "EVALUATION_ERROR",
            "NOT_APPLICABLE_BY_PROFILE"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "control_id",
        "mandatory",
        "status",
        "reason_code",
        "delta",
        "reason",
        "evidence_refs"
      ],
      "title": "ControlResult",
      "type": "object"
    },
    "EvaluationVersions": {
      "additionalProperties": false,
      "properties": {
        "casm": {
          "const": "1.0",
          "title": "Casm",
          "type": "string"
        },
        "engine_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Engine Ref",
          "type": "string"
        },
        "mapping_refs": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Mapping Refs",
          "type": "array"
        },
        "profile_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Profile Ref",
          "type": "string"
        },
        "rules_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Rules Ref",
          "type": "string"
        }
      },
      "required": [
        "casm",
        "profile_ref",
        "rules_ref",
        "mapping_refs",
        "engine_ref"
      ],
      "title": "EvaluationVersions",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "``{\"atoms\": \"1000000000\", \"scale\": 7, \"unit\": \"FUND_SHARE\"}`` is 100 shares.",
      "properties": {
        "atoms": {
          "maxLength": 79,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "title": "Atoms",
          "type": "string"
        },
        "scale": {
          "maximum": 38,
          "minimum": 0,
          "title": "Scale",
          "type": "integer"
        },
        "unit": {
          "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "atoms",
        "scale",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    }
  },
  "$id": "urn:invaria:schema:evaluation-result:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable evaluation artifact. Currency (current/stale/superseded) is a separate\nprojection and never edits this record.",
  "properties": {
    "assumptions": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "controls": {
      "items": {
        "$ref": "#/$defs/ControlResult"
      },
      "minItems": 1,
      "title": "Controls",
      "type": "array"
    },
    "evaluation_clock": {
      "format": "date-time",
      "title": "Evaluation Clock",
      "type": "string"
    },
    "evaluation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Evaluation Id",
      "type": "string"
    },
    "operation_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Operation Ref",
      "type": "string"
    },
    "result": {
      "enum": [
        "MATCH",
        "BREAK",
        "UNKNOWN"
      ],
      "title": "Result",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "versions": {
      "$ref": "#/$defs/EvaluationVersions"
    }
  },
  "required": [
    "schema_version",
    "evaluation_id",
    "snapshot_id",
    "operation_ref",
    "result",
    "controls",
    "versions",
    "evaluation_clock",
    "assumptions"
  ],
  "title": "EvaluationResult",
  "type": "object"
}
