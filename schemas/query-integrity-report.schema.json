    "IntegrityMember": {
      "additionalProperties": false,
      "description": "One included operation and the facts of its selection, pinned at the read.",
      "properties": {
        "epochs_without_publication": {
          "items": {
            "type": "integer"
          },
          "title": "Epochs Without Publication",
          "type": "array"
        },
        "latest_stored_evaluation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
