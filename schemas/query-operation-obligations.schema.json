{
  "$defs": {
    "ApplicabilityCheckView": {
      "additionalProperties": false,
      "description": "The engine's own check of the obligation's condition in one control;\nstatus is None when no diagnosis is available.",
      "properties": {
        "control_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "explanation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "EXACT_MATCH",
                "CASH_AMOUNT_MISMATCH",
                "UNITS_MISMATCH",
                "ORDER_TERMS_INCONSISTENT",
                "MISSING_EVIDENCE",
                "INSUFFICIENT_COVERAGE",
                "LOSS_OF_SUPPORT",
                "SOURCE_CONFLICT",
                "AMBIGUOUS_MATCH",
                "QUARANTINED_INPUT",
                "UNSUPPORTED_CAPABILITY",
                "EVALUATION_ERROR",
                "NOT_APPLICABLE_BY_PROFILE",
                "PRICE_MISMATCH",
                "UNITS_EXCEED_POSITION",
                "PAYMENT_LATE",
                "PAYMENT_MISSED",
                "SETTLED_DESPITE_CANCELLATION",
                "INEXACT_AMOUNT",
                "PAYMENT_NOT_DUE",
                "INVALID_CANCELLATION",
                "EXTINGUISHED_BY_CANCELLATION",
                "NO_CANCELLATION",
                "DEADLINE_DATA_CONFLICT",
                "BURN_BEFORE_ACCEPTANCE_UNSUPPORTED",
                "AMBIGUOUS_SEQUENCE",
                "POSITION_NOT_BEFORE_ACCEPTANCE",
                "REACTIVATION_UNSUPPORTED",
                "PAYMENT_TO_WRONG_ACCOUNT",
                "INVALID_RETRACTION"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "requirement_id": {
          "maxLength": 64,
          "pattern": "^[a-z_]+$",
          "title": "Requirement Id",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "satisfied",
                "contradicted",
                "undetermined",
                "not_applicable",
                "not_evaluated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status"
        }
      },
      "required": [
        "control_id",
        "requirement_id",
        "status",
        "reason_code",
        "explanation"
      ],
      "title": "ApplicabilityCheckView",
      "type": "object"
    },
    "ApplicabilityView": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/ApplicabilityCheckView"
          },
          "title": "Checks",
          "type": "array"
        },
        "condition": {
          "enum": [
            "always",
            "unless_cancelled",
            "cancellation"
          ],
          "title": "Condition",
          "type": "string"
        },
        "declared_by": {
          "items": {
            "$ref": "#/$defs/ProfileBasisView"
          },
          "title": "Declared By",
          "type": "array"
        },
        "state": {
          "enum": [
            "applies",
            "not_applicable",
            "mixed",
            "not_determined"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "condition",
        "declared_by",
        "state",
        "checks"
      ],
      "title": "ApplicabilityView",
      "type": "object"
    },
    "BlockView": {
      "additionalProperties": false,
      "description": "The undetermined check that fixed a linked control's result.",
      "properties": {
        "category": {
          "anyOf": [
            {
              "enum": [
                "missing_evidence",
                "withdrawn_evidence",
                "source_conflict",
                "inconsistent_evidence",
                "invalid_evidence",
                "insufficient_coverage",
                "quarantined_input",
                "unattributed",
                "unsupported_capability",
                "not_yet_due",
                "technical_error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Category"
        },
        "control_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "explanation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "next_step": {
          "anyOf": [
            {
              "$ref": "#/$defs/NextStepView"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "EXACT_MATCH",
                "CASH_AMOUNT_MISMATCH",
                "UNITS_MISMATCH",
                "ORDER_TERMS_INCONSISTENT",
                "MISSING_EVIDENCE",
                "INSUFFICIENT_COVERAGE",
                "LOSS_OF_SUPPORT",
                "SOURCE_CONFLICT",
                "AMBIGUOUS_MATCH",
                "QUARANTINED_INPUT",
                "UNSUPPORTED_CAPABILITY",
                "EVALUATION_ERROR",
                "NOT_APPLICABLE_BY_PROFILE",
                "PRICE_MISMATCH",
                "UNITS_EXCEED_POSITION",
                "PAYMENT_LATE",
                "PAYMENT_MISSED",
                "SETTLED_DESPITE_CANCELLATION",
                "INEXACT_AMOUNT",
                "PAYMENT_NOT_DUE",
                "INVALID_CANCELLATION",
                "EXTINGUISHED_BY_CANCELLATION",
                "NO_CANCELLATION",
                "DEADLINE_DATA_CONFLICT",
                "BURN_BEFORE_ACCEPTANCE_UNSUPPORTED",
                "AMBIGUOUS_SEQUENCE",
                "POSITION_NOT_BEFORE_ACCEPTANCE",
                "REACTIVATION_UNSUPPORTED",
                "PAYMENT_TO_WRONG_ACCOUNT",
                "INVALID_RETRACTION"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "requirement_id": {
          "maxLength": 64,
          "pattern": "^[a-z_]+(:[a-z_]+)?$",
          "title": "Requirement Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "performance",
            "timeliness",
            "term",
            "applicability_condition"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "control_id",
        "role",
        "requirement_id",
        "category",
        "reason_code",
        "explanation",
        "next_step"
      ],
      "title": "BlockView",
      "type": "object"
    },
    "ControlDiagnosisView": {
      "additionalProperties": false,
      "description": "What the engine checked for one control of a stored evaluation, and where it\nstopped; reconstructed by replaying the recorded engine on the closed snapshot.",
      "properties": {
        "concluded": {
          "title": "Concluded",
          "type": "boolean"
        },
        "control_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "diagnosis": {
          "enum": [
            "reconstructed",
            "unavailable_for_engine",
            "reconstruction_mismatch"
          ],
          "title": "Diagnosis",
          "type": "string"
        },
        "engine_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Engine Ref",
          "type": "string"
        },
        "engine_status": {
          "enum": [
            "current",
            "retired",
            "blocked",
            "unknown"
          ],
          "title": "Engine Status",
          "type": "string"
        },
        "evaluation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "operation_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Operation Ref",
          "type": "string"
        },
        "profile_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Profile Ref",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "EXACT_MATCH",
            "CASH_AMOUNT_MISMATCH",
            "UNITS_MISMATCH",
            "ORDER_TERMS_INCONSISTENT",
            "MISSING_EVIDENCE",
            "INSUFFICIENT_COVERAGE",
            "LOSS_OF_SUPPORT",
            "SOURCE_CONFLICT",
            "AMBIGUOUS_MATCH",
            "QUARANTINED_INPUT",
            "UNSUPPORTED_CAPABILITY",
            "EVALUATION_ERROR",
            "NOT_APPLICABLE_BY_PROFILE",
            "PRICE_MISMATCH",
            "UNITS_EXCEED_POSITION",
            "PAYMENT_LATE",
            "PAYMENT_MISSED",
            "SETTLED_DESPITE_CANCELLATION",
            "INEXACT_AMOUNT",
            "PAYMENT_NOT_DUE",
            "INVALID_CANCELLATION",
            "EXTINGUISHED_BY_CANCELLATION",
            "NO_CANCELLATION",
            "DEADLINE_DATA_CONFLICT",
            "BURN_BEFORE_ACCEPTANCE_UNSUPPORTED",
            "AMBIGUOUS_SEQUENCE",
            "POSITION_NOT_BEFORE_ACCEPTANCE",
            "REACTIVATION_UNSUPPORTED",
            "PAYMENT_TO_WRONG_ACCOUNT",
            "INVALID_RETRACTION"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "replay_consistent": {
          "title": "Replay Consistent",
          "type": "boolean"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/RequirementCheckView"
          },
          "title": "Requirements",
          "type": "array"
        },
        "rules_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Rules Ref",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/SnapshotView"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "evaluation_id",
        "operation_ref",
        "snapshot",
        "profile_ref",
        "rules_ref",
        "engine_ref",
        "engine_status",
        "control_id",
        "mandatory",
        "status",
        "reason_code",
        "concluded",
        "diagnosis",
        "replay_consistent",
        "requirements",
        "limitations"
      ],
      "title": "ControlDiagnosisView",
      "type": "object"
    },
    "CurrencyView": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "enum": [
            "current",
            "stale",
            "superseded",
            "not_published"
          ],
          "title": "Currency",
          "type": "string"
        },
        "published_epoch": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published Epoch"
        },
        "scope_epoch": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope Epoch"
        }
      },
      "required": [
        "currency",
        "scope_epoch",
        "published_epoch"
      ],
      "title": "CurrencyView",
      "type": "object"
    },
    "NextStepView": {
      "additionalProperties": false,
      "description": "A deterministic suggestion derived from the block; never a promise of a result.",
      "properties": {
        "authoritative_source": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Authoritative Source"
        },
        "caveat": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Caveat",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "fact_type": {
          "anyOf": [
            {
              "enum": [
                "order_accepted",
                "cash_settled",
                "units_registered",
                "token_movement",
                "redemption_accepted",
                "redemption_cancelled",
                "position_held",
                "price_approved",
                "position_changed",
                "redemption_reactivated",
                "chain_effect"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fact Type"
        },
        "kind": {
          "enum": [
            "provide_observation",
            "obtain_coverage",
            "resolve_source_conflict",
            "review_inconsistent_evidence",
            "resolve_quarantine",
            "provide_approved_link",
            "await_due_time",
            "correct_technical_error",
            "outside_declared_capabilities"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mapping_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mapping Ref"
        },
        "min_coverage_level": {
          "anyOf": [
            {
              "enum": [
                "provider_claimed",
                "internally_checked",
                "independently_verified"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Coverage Level"
        },
        "must_cover": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Must Cover"
        }
      },
      "required": [
        "kind",
        "description",
        "fact_type",
        "authoritative_source",
        "mapping_ref",
        "min_coverage_level",
        "must_cover",
        "caveat"
      ],
      "title": "NextStepView",
      "type": "object"
    },
    "NotProjectedView": {
      "additionalProperties": false,
      "description": "A possible obligation the catalogue leaves out, and why.",
      "properties": {
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "description",
        "reason"
      ],
      "title": "NotProjectedView",
      "type": "object"
    },
    "ObligationControlLink": {
