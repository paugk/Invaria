          "title": "Control Id",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "EXACT_MATCH",
            "CASH_AMOUNT_MISMATCH",
            "UNITS_MISMATCH",
            "ORDER_TERMS_INCONSISTENT",
            "MISSING_EVIDENCE",
            "INSUFFICIENT_COVERAGE",
            "LOSS_OF_SUPPORT",
            "SOURCE_CONFLICT",
            "AMBIGUOUS_MATCH",
            "QUARANTINED_INPUT",
            "UNSUPPORTED_CAPABILITY",
            "EVALUATION_ERROR",
            "NOT_APPLICABLE_BY_PROFILE",
            "PRICE_MISMATCH",
            "UNITS_EXCEED_POSITION",
            "PAYMENT_LATE",
            "PAYMENT_MISSED",
            "SETTLED_DESPITE_CANCELLATION",
            "INEXACT_AMOUNT",
            "PAYMENT_NOT_DUE",
            "INVALID_CANCELLATION",
            "EXTINGUISHED_BY_CANCELLATION",
            "NO_CANCELLATION",
            "DEADLINE_DATA_CONFLICT",
            "BURN_BEFORE_ACCEPTANCE_UNSUPPORTED",
            "AMBIGUOUS_SEQUENCE",
            "POSITION_NOT_BEFORE_ACCEPTANCE",
            "REACTIVATION_UNSUPPORTED",
            "PAYMENT_TO_WRONG_ACCOUNT",
            "INVALID_RETRACTION"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "relation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Relation",
          "type": "string"
        },
        "role": {
          "enum": [
            "performance",
            "timeliness",
            "term",
            "applicability_condition"
          ],
          "title": "Role",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "control_id",
        "role",
        "relation",
        "status",
        "reason_code",
        "concluded"
      ],
      "title": "ObligationControlLink",
      "type": "object"
    },
    "ObligationControlView": {
      "additionalProperties": false,
      "description": "One control of the evaluation, once, with its stored result and requirement diagnosis.",
      "properties": {
        "concluded": {
          "title": "Concluded",
          "type": "boolean"
        },
        "control_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "diagnosis": {
          "$ref": "#/$defs/ControlDiagnosisView"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Evidence Refs",
          "type": "array"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "obligations": {
          "items": {
            "maxLength": 64,
            "pattern": "^[a-z]+\\.[a-z_]+$",
            "type": "string"
          },
          "title": "Obligations",
          "type": "array"
        },
        "reason_code": {
          "enum": [
            "EXACT_MATCH",
            "CASH_AMOUNT_MISMATCH",
            "UNITS_MISMATCH",
            "ORDER_TERMS_INCONSISTENT",
            "MISSING_EVIDENCE",
            "INSUFFICIENT_COVERAGE",
            "LOSS_OF_SUPPORT",
            "SOURCE_CONFLICT",
            "AMBIGUOUS_MATCH",
            "QUARANTINED_INPUT",
            "UNSUPPORTED_CAPABILITY",
            "EVALUATION_ERROR",
            "NOT_APPLICABLE_BY_PROFILE",
            "PRICE_MISMATCH",
            "UNITS_EXCEED_POSITION",
            "PAYMENT_LATE",
            "PAYMENT_MISSED",
            "SETTLED_DESPITE_CANCELLATION",
            "INEXACT_AMOUNT",
            "PAYMENT_NOT_DUE",
            "INVALID_CANCELLATION",
            "EXTINGUISHED_BY_CANCELLATION",
            "NO_CANCELLATION",
            "DEADLINE_DATA_CONFLICT",
            "BURN_BEFORE_ACCEPTANCE_UNSUPPORTED",
            "AMBIGUOUS_SEQUENCE",
            "POSITION_NOT_BEFORE_ACCEPTANCE",
            "REACTIVATION_UNSUPPORTED",
            "PAYMENT_TO_WRONG_ACCOUNT",
            "INVALID_RETRACTION"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "control_id",
        "mandatory",
        "status",
        "reason_code",
        "concluded",
        "evidence_refs",
        "obligations",
        "diagnosis"
      ],
      "title": "ObligationControlView",
      "type": "object"
    },
    "ObligationView": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/ApplicabilityView"
        },
        "basis": {
          "items": {
            "$ref": "#/$defs/ProfileBasisView"
          },
          "minItems": 1,
          "title": "Basis",
          "type": "array"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/BlockView"
          },
          "title": "Blocks",
          "type": "array"
        },
        "controls": {
          "items": {
            "$ref": "#/$defs/ObligationControlLink"
          },
          "minItems": 1,
          "title": "Controls",
          "type": "array"
        },
        "coverage_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Coverage Ids",
          "type": "array"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Evidence Refs",
          "type": "array"
        },
        "limitations": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "not_derivable": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Not Derivable",
          "type": "array"
        },
        "obligation_id": {
          "maxLength": 64,
          "pattern": "^[a-z]+\\.[a-z_]+$",
          "title": "Obligation Id",
          "type": "string"
        },
        "observed": {
          "items": {
            "$ref": "#/$defs/ObservedComparisonView"
          },
          "title": "Observed",
          "type": "array"
        }
      },
      "required": [
        "obligation_id",
        "description",
        "basis",
        "applicability",
        "controls",
        "observed",
        "blocks",
        "evidence_refs",
        "coverage_ids",
        "not_derivable",
        "limitations"
      ],
      "title": "ObligationView",
      "type": "object"
    },
    "ObservedComparisonView": {
      "additionalProperties": false,
      "description": "A comparison the engine recorded. ``observed_only``: it did not fix the control's\nresult, so it is not a conclusion about the obligation.",
      "properties": {
        "control_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "left": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "right": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "enum": [
            "decided",
            "observed_only"
          ],
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "satisfied",
            "contradicted",
            "undetermined",
            "not_applicable",
            "not_evaluated"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "control_id",
        "status",
        "scope",
        "left",
        "right",
        "delta"
      ],
      "title": "ObservedComparisonView",
      "type": "object"
    },
    "ProfileBasisView": {
      "additionalProperties": false,
      "description": "A rule of the profile, read from the evaluation's own profile: what it requires.",
      "properties": {
        "path": {
          "maxLength": 128,
          "pattern": "^[a-z_]+(\\[[a-z0-9_.]+\\])?(\\.[a-z_]+)*$",
          "title": "Path",
          "type": "string"
        },
        "value": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "path",
        "value"
      ],
      "title": "ProfileBasisView",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "``{\"atoms\": \"1000000000\", \"scale\": 7, \"unit\": \"FUND_SHARE\"}`` is 100 shares.",
      "properties": {
        "atoms": {
          "maxLength": 79,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "title": "Atoms",
          "type": "string"
        },
        "scale": {
          "maximum": 38,
          "minimum": 0,
          "title": "Scale",
          "type": "integer"
        },
        "unit": {
          "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "atoms",
        "scale",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "RequirementCheckView": {
      "additionalProperties": false,
      "properties": {
        "admitted_evidence": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Admitted Evidence",
          "type": "array"
        },
        "applies_when": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Applies When",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "enum": [
                "missing_evidence",
                "withdrawn_evidence",
                "source_conflict",
                "inconsistent_evidence",
                "invalid_evidence",
                "insufficient_coverage",
                "quarantined_input",
                "unattributed",
                "unsupported_capability",
                "not_yet_due",
                "technical_error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Category"
        },
        "coverage_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Coverage Ids",
          "type": "array"
        },
        "delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "determined_result": {
          "title": "Determined Result",
          "type": "boolean"
        },
        "explanation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "left": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_step": {
          "anyOf": [
            {
              "$ref": "#/$defs/NextStepView"
            },
            {
              "type": "null"
            }
          ]
        },
        "questioned_evidence": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Questioned Evidence",
          "type": "array"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "EXACT_MATCH",
                "CASH_AMOUNT_MISMATCH",
                "UNITS_MISMATCH",
                "ORDER_TERMS_INCONSISTENT",
                "MISSING_EVIDENCE",
                "INSUFFICIENT_COVERAGE",
                "LOSS_OF_SUPPORT",
                "SOURCE_CONFLICT",
                "AMBIGUOUS_MATCH",
                "QUARANTINED_INPUT",
                "UNSUPPORTED_CAPABILITY",
                "EVALUATION_ERROR",
                "NOT_APPLICABLE_BY_PROFILE",
                "PRICE_MISMATCH",
                "UNITS_EXCEED_POSITION",
                "PAYMENT_LATE",
                "PAYMENT_MISSED",
                "SETTLED_DESPITE_CANCELLATION",
                "INEXACT_AMOUNT",
                "PAYMENT_NOT_DUE",
                "INVALID_CANCELLATION",
                "EXTINGUISHED_BY_CANCELLATION",
                "NO_CANCELLATION",
                "DEADLINE_DATA_CONFLICT",
                "BURN_BEFORE_ACCEPTANCE_UNSUPPORTED",
                "AMBIGUOUS_SEQUENCE",
                "POSITION_NOT_BEFORE_ACCEPTANCE",
                "REACTIVATION_UNSUPPORTED",
                "PAYMENT_TO_WRONG_ACCOUNT",
                "INVALID_RETRACTION"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "requirement_id": {
          "maxLength": 64,
          "pattern": "^[a-z_]+(:[a-z_]+)?$",
          "title": "Requirement Id",
          "type": "string"
        },
        "right": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "set_aside_evidence": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Set Aside Evidence",
          "type": "array"
        },
        "status": {
          "enum": [
            "satisfied",
            "contradicted",
            "undetermined",
            "not_applicable",
            "not_evaluated"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "description",
        "applies_when",
        "status",
        "determined_result",
        "category",
        "reason_code",
        "explanation",
        "admitted_evidence",
        "questioned_evidence",
        "set_aside_evidence",
        "coverage_ids",
        "left",
        "right",
        "delta",
        "next_step"
      ],
      "title": "RequirementCheckView",
      "type": "object"
    },
    "SnapshotView": {
      "additionalProperties": false,
      "properties": {
        "evaluation_clock": {
          "format": "date-time",
          "title": "Evaluation Clock",
          "type": "string"
        },
        "known_at": {
          "format": "date-time",
          "title": "Known At",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "valid_at": {
          "format": "date-time",
          "title": "Valid At",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "valid_at",
        "known_at",
        "evaluation_clock"
      ],
      "title": "SnapshotView",
      "type": "object"
    },
    "VersionsView": {
      "additionalProperties": false,
      "properties": {
        "engine_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Engine Ref",
          "type": "string"
        },
        "engine_status": {
          "enum": [
            "current",
            "retired",
            "blocked",
            "unknown"
          ],
          "title": "Engine Status",
          "type": "string"
        },
        "profile_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Profile Ref",
          "type": "string"
        },
        "rules_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Rules Ref",
          "type": "string"
        }
      },
      "required": [
        "profile_ref",
        "rules_ref",
        "engine_ref",
        "engine_status"
      ],
      "title": "VersionsView",
      "type": "object"
    }
  },
  "$id": "urn:invaria:schema:query-operation-obligations:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The obligations a catalogued profile sets for an operation, projected from the\nprofile, the closed snapshot and the stored evaluation. Not a second result.",
  "properties": {
    "catalogue": {
      "enum": [
        "available",
        "unavailable_for_profile",
        "mismatch_with_profile"
      ],
      "title": "Catalogue",
      "type": "string"
    },
    "catalogue_ref": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Catalogue Ref"
    },
    "controls": {
      "items": {
        "$ref": "#/$defs/ObligationControlView"
      },
      "title": "Controls",
      "type": "array"
    },
    "currency": {
      "anyOf": [
        {
          "$ref": "#/$defs/CurrencyView"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnosis": {
      "enum": [
        "reconstructed",
        "unavailable_for_engine",
        "reconstruction_mismatch"
      ],
      "title": "Diagnosis",
      "type": "string"
    },
    "evaluation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Evaluation Id",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "not_projected": {
      "items": {
        "$ref": "#/$defs/NotProjectedView"
      },
      "title": "Not Projected",
      "type": "array"
    },
    "obligations": {
      "items": {
        "$ref": "#/$defs/ObligationView"
      },
      "title": "Obligations",
      "type": "array"
    },
    "operation_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Operation Ref",
      "type": "string"
    },
    "operation_state": {
      "anyOf": [
        {
          "const": "cancelled",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Operation State"
    },
    "replay_consistent": {
      "title": "Replay Consistent",
      "type": "boolean"
    },
    "result": {
      "enum": [
        "MATCH",
        "BREAK",
        "UNKNOWN"
      ],
      "title": "Result",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/SnapshotView"
    },
    "versions": {
      "$ref": "#/$defs/VersionsView"
    }
  },
  "required": [
    "schema_version",
    "operation_ref",
    "evaluation_id",
    "result",
    "operation_state",
    "snapshot",
    "currency",
    "versions",
    "catalogue_ref",
    "catalogue",
    "diagnosis",
    "replay_consistent",
    "obligations",
    "controls",
    "not_projected",
    "limitations"
  ],
  "title": "OperationObligationsView",
  "type": "object"
}
