          "title": "Comparison",
          "type": "string"
        },
        "control_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "coverage": {
          "enum": [
