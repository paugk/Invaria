          "title": "Status",
          "type": "string"
        },
        "status_detail": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Status Detail",
          "type": "array"
        },
        "stored_evaluations": {
          "title": "Stored Evaluations",
          "type": "integer"
        }
      },
      "required": [
