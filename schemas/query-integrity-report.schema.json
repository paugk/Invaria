        "status",
        "status_detail",
        "profile_ref",
        "scope_epoch",
        "stored_evaluations",
        "latest_stored_evaluation_id",
        "selected",
        "published_history",
        "epochs_without_publication"
      ],
      "title": "IntegrityMember",
      "type": "object"
    },
    "MetricView": {
      "additionalProperties": false,
      "description": "A count, or a ratio with both terms; never a bare percentage.",
      "properties": {
        "cases_key": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Cases Key",
          "type": "string"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Denominator"
        },
        "denominator_definition": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Denominator Definition"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "count",
            "ratio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "metric_id": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "numerator": {
          "title": "Numerator",
          "type": "integer"
        },
        "numerator_definition": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Numerator Definition",
          "type": "string"
        },
        "undefined_reason": {
          "anyOf": [
            {
              "enum": [
                "denominator_zero",
                "incomplete"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Undefined Reason"
        },
        "unknown_excluded": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
