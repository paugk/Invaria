{
  "schema_version": "1.0",
  "kind": "golden_verifier_corpus",
  "synthetic": true,
  "cases": [
    {
      "case_id": "r1-unsigned",
      "bundle": "k3-r1",
      "overlay": null,
      "remove": [],
      "level": "R1",
      "trust_store": false,
      "trust_at": null,
      "expected_status": "REPRODUCED",
      "expected_trust": "unanchored",
      "expected_financial_result": "BREAK",
      "description": "R1 replay of K3 without any trust anchor"
    },
    {
      "case_id": "r1-unsigned-store-required",
      "bundle": "k3-r1",
      "overlay": null,
      "remove": [],
      "level": "R1",
      "trust_store": true,
      "trust_at": null,
      "expected_status": "UNTRUSTED",
      "expected_trust": "unanchored",
      "expected_financial_result": null,
      "description": "a trust store is given but the bundle is unsigned"
    },
    {
      "case_id": "r2-bundle-at-r1",
      "bundle": "k3-r2",
      "overlay": null,
      "remove": [],
      "level": "R1",
      "trust_store": false,
      "trust_at": null,
      "expected_status": "REPRODUCED",
      "expected_trust": "unanchored",
      "expected_financial_result": "BREAK",
      "description": "R2 bundle verified at R1"
    },
    {
      "case_id": "r2-with-chain-member",
      "bundle": "k3-r2",
      "overlay": null,
      "remove": [],
      "level": "R2",
      "trust_store": false,
      "trust_at": null,
      "expected_status": "INCOMPLETE",
      "expected_trust": "unanchored",
      "expected_financial_result": "BREAK",
      "description": "obs-T1 has no local normaliser: R2 is INCOMPLETE; the CSV members are listed",
      "expected_renormalized": 4
    },
    {
      "case_id": "r2-csv-only",
      "bundle": "k2-csv-r2",
      "overlay": null,
      "remove": [],
      "level": "R2",
      "trust_store": false,
      "trust_at": null,
      "expected_status": "REPRODUCED",
      "expected_trust": "unanchored",
      "expected_financial_result": "UNKNOWN",
      "description": "every member renormalised from raw bytes; the missing chain evidence makes the result UNKNOWN",
      "expected_renormalized": 3
    },
    {
      "case_id": "tampered-byte",
      "bundle": "k3-r1",
      "overlay": "tampered-byte",
      "remove": [],
      "level": "R1",
      "trust_store": false,
      "trust_at": null,
      "expected_status": "REJECTED",
      "expected_trust": "unanchored",
      "expected_financial_result": null,
      "description": "evaluation.json changed after hashing"
    },
    {
      "case_id": "undeclared-file",
      "bundle": "k3-r1",
      "overlay": "undeclared-file",
      "remove": [],
      "level": "R1",
      "trust_store": false,
      "trust_at": null,
      "expected_status": "REJECTED",
      "expected_trust": "unanchored",
      "expected_financial_result": null,
      "description": "an executable file not in the manifest is never run"
    },
    {
      "case_id": "traversal-path",
      "bundle": "k3-r1",
      "overlay": "traversal-path",
      "remove": [],
      "level": "R1",
      "trust_store": false,
      "trust_at": null,
      "expected_status": "REJECTED",
      "expected_trust": "unanchored",
      "expected_financial_result": null,
      "description": "manifest declares ../evaluation.json"
    },
    {
      "case_id": "deep-json",
      "bundle": "k3-r1",
      "overlay": "deep-json",
      "remove": [],
      "level": "R1",
      "trust_store": false,
      "trust_at": null,
      "expected_status": "REJECTED",
      "expected_trust": "unanchored",
      "expected_financial_result": null,
      "description": "manifest nests JSON 100 levels deep"
    },
    {
      "case_id": "missing-r1-artifact",
      "bundle": "k3-r1",
      "overlay": null,
      "remove": [
        "evidence.json"
      ],
      "level": "R1",
      "trust_store": false,
      "trust_at": null,
      "expected_status": "INCOMPLETE",
      "expected_trust": "unanchored",
      "expected_financial_result": null,
      "description": "evidence.json removed"
    },
    {
      "case_id": "missing-raw-at-r2",
      "bundle": "k2-csv-r2",
      "overlay": null,
      "remove": [
        "raw/bank_statement_2026-10-01.csv"
      ],
      "level": "R2",
      "trust_store": false,
      "trust_at": null,
      "expected_status": "INCOMPLETE",
      "expected_trust": "unanchored",
      "expected_financial_result": null,
      "description": "raw bank statement removed; R2 cannot run"
    },
    {
      "case_id": "missing-raw-at-r1",
      "bundle": "k2-csv-r2",
      "overlay": null,
      "remove": [
        "raw/bank_statement_2026-10-01.csv"
      ],
      "level": "R1",
      "trust_store": false,
      "trust_at": null,
      "expected_status": "REPRODUCED",
      "expected_trust": "unanchored",
      "expected_financial_result": "UNKNOWN",
      "description": "raw bytes are only needed for R2"
    },
    {
      "case_id": "r2-raw-tampered",
      "bundle": "k2-csv-r2",
      "overlay": "r2-raw-tampered",
      "remove": [],
      "level": "R2",
      "trust_store": false,
      "trust_at": null,
      "expected_status": "MISMATCH",
      "expected_trust": "unanchored",
      "expected_financial_result": "UNKNOWN",
      "description": "raw CSV amount changed and the manifest rehashed"
    },
    {
      "case_id": "r2-mapping-tampered",
      "bundle": "k2-csv-r2",
      "overlay": "r2-mapping-tampered",
      "remove": [],
      "level": "R2",
      "trust_store": false,
      "trust_at": null,
      "expected_status": "MISMATCH",
      "expected_trust": "unanchored",
      "expected_financial_result": "UNKNOWN",
      "description": "mapping scale changed and the manifest rehashed"
    },
    {
      "case_id": "signed-trusted",
      "bundle": "k3-r1",
      "overlay": "signed",
      "remove": [],
      "level": "R1",
      "trust_store": true,
      "trust_at": null,
      "expected_status": "REPRODUCED",
      "expected_trust": "trusted_signature",
      "expected_financial_result": "BREAK",
      "description": "valid signature by a trusted key"
    },
    {
      "case_id": "signed-no-store",
      "bundle": "k3-r1",
      "overlay": "signed",
      "remove": [],
      "level": "R1",
      "trust_store": false,
      "trust_at": null,
      "expected_status": "REPRODUCED",
      "expected_trust": "unanchored",
      "expected_financial_result": "BREAK",
      "description": "a signature without a trust store is not verified"
    },
    {
      "case_id": "signed-two-required",
      "bundle": "k3-r1",
      "overlay": "signed",
      "remove": [],
      "level": "R1",
      "trust_store": true,
      "trust_at": null,
      "expected_status": "UNTRUSTED",
      "expected_trust": "unanchored",
      "expected_financial_result": null,
      "description": "policy requires two signatures",
      "min_signatures": 2
    },
    {
      "case_id": "signed-rotated-at-signing",
      "bundle": "k3-r1",
      "overlay": "signed-rotated",
      "remove": [],
      "level": "R1",
      "trust_store": true,
      "trust_at": null,
      "expected_status": "REPRODUCED",
      "expected_trust": "trusted_signature",
      "expected_financial_result": "BREAK",
      "description": "key superseded after signing: trusted as of signed_at"
    },
    {
      "case_id": "signed-rotated-now",
      "bundle": "k3-r1",
      "overlay": "signed-rotated",
      "remove": [],
      "level": "R1",
      "trust_store": true,
      "trust_at": "2026-10-05T00:00:00Z",
      "expected_status": "UNTRUSTED",
      "expected_trust": "unanchored",
      "expected_financial_result": null,
      "description": "same signature judged after the rotation"
    },
    {
      "case_id": "signed-compromised",
      "bundle": "k3-r1",
      "overlay": "signed-compromised",
      "remove": [],
      "level": "R1",
      "trust_store": true,
      "trust_at": null,
      "expected_status": "UNTRUSTED",
      "expected_trust": "unanchored",
      "expected_financial_result": null,
      "description": "key revoked for compromise: signed_at could be backdated"
    },
    {
      "case_id": "signed-unknown-key",
      "bundle": "k3-r1",
      "overlay": "signed-unknown-key",
      "remove": [],
      "level": "R1",
      "trust_store": true,
      "trust_at": null,
      "expected_status": "UNTRUSTED",
      "expected_trust": "unanchored",
      "expected_financial_result": null,
      "description": "signer not in the trust store"
    },
    {
      "case_id": "signed-manifest-altered",
      "bundle": "k3-r1",
      "overlay": "signed-manifest-altered",
      "remove": [],
      "level": "R1",
      "trust_store": true,
      "trust_at": null,
      "expected_status": "UNTRUSTED",
      "expected_trust": "unanchored",
      "expected_financial_result": null,
      "description": "manifest changed after signing"
