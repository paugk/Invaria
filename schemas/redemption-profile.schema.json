      },
      "title": "Coverage Requirements",
      "type": "array"
    },
    "disclaimer": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Disclaimer",
      "type": "string"
    },
    "evidence_policy": {
      "$ref": "#/$defs/EvidencePolicy"
