{
  "$defs": {
    "ControlSpec": {
      "additionalProperties": false,
      "properties": {
        "comparison": {
          "const": "exact_equal",
          "title": "Comparison",
          "type": "string"
        },
        "control_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "failure_code": {
          "enum": [
            "CASH_AMOUNT_MISMATCH",
            "UNITS_MISMATCH",
            "ORDER_TERMS_INCONSISTENT"
          ],
          "title": "Failure Code",
          "type": "string"
        },
        "left": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Left",
          "type": "string"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "on_conflict": {
          "const": "UNKNOWN",
          "title": "On Conflict",
          "type": "string"
        },
        "on_unsupported": {
          "const": "UNKNOWN",
          "title": "On Unsupported",
          "type": "string"
        },
        "requires": {
          "items": {
            "enum": [
              "order_accepted",
              "cash_settled",
              "units_registered",
              "token_movement",
              "redemption_accepted",
              "redemption_cancelled",
              "position_held",
              "price_approved",
              "position_changed",
              "redemption_reactivated",
              "chain_effect"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Requires",
          "type": "array"
        },
        "right": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Right",
          "type": "string"
        },
        "when_missing": {
          "const": "UNKNOWN",
          "title": "When Missing",
          "type": "string"
        }
      },
      "required": [
        "control_id",
        "mandatory",
        "requires",
        "comparison",
        "left",
        "right",
        "failure_code",
        "when_missing",
        "on_conflict",
        "on_unsupported"
      ],
      "title": "ControlSpec",
      "type": "object"
    },
    "Correlation": {
      "additionalProperties": false,
      "properties": {
        "account_link": {
          "const": "approved_identity_link",
          "title": "Account Link",
          "type": "string"
        },
        "chain_link": {
          "const": "explicit_execution_link_only",
          "title": "Chain Link",
          "type": "string"
        },
        "institutional_link": {
          "const": "operation_ref_equals_order_ref",
          "title": "Institutional Link",
          "type": "string"
        },
        "muxed_account_link": {
          "anyOf": [
            {
              "const": "identity_link_to_the_muxed_address_only",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Muxed Account Link"
        },
        "operation_key": {
          "const": "order_ref",
          "title": "Operation Key",
          "type": "string"
        }
      },
      "required": [
        "operation_key",
        "institutional_link",
        "chain_link",
        "account_link"
      ],
      "title": "Correlation",
      "type": "object"
    },
    "CoverageRequirement": {
      "additionalProperties": false,
      "properties": {
        "absence_needs_chain_scope": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Absence Needs Chain Scope"
        },
        "completeness_needs_coverage": {
          "anyOf": [
            {
              "const": true,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completeness Needs Coverage"
        },
        "fact_types": {
          "items": {
            "enum": [
              "order_accepted",
              "cash_settled",
              "units_registered",
              "token_movement",
              "redemption_accepted",
              "redemption_cancelled",
              "position_held",
              "price_approved",
              "position_changed",
              "redemption_reactivated",
              "chain_effect"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Types",
          "type": "array"
        },
        "gaps_allowed": {
          "const": false,
          "title": "Gaps Allowed",
          "type": "boolean"
        },
        "min_level": {
          "enum": [
            "provider_claimed",
            "internally_checked",
            "independently_verified"
          ],
          "title": "Min Level",
          "type": "string"
        },
        "must_cover": {
          "const": "order_valid_time_to_valid_at",
          "title": "Must Cover",
          "type": "string"
        },
        "quarantine_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuarantinePolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quarantine_scope": {
          "anyOf": [
            {
              "const": "records_bearing_on_operation",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quarantine Scope"
        },
        "quarantined_records_allowed": {
          "const": false,
          "title": "Quarantined Records Allowed",
          "type": "boolean"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "fact_types",
        "min_level",
        "must_cover",
        "gaps_allowed",
        "quarantined_records_allowed"
      ],
      "title": "CoverageRequirement",
      "type": "object"
    },
    "EvidencePolicy": {
      "additionalProperties": false,
      "properties": {
        "absent": {
          "const": "UNKNOWN",
          "title": "Absent",
          "type": "string"
        },
        "conflicting_authoritative": {
          "const": "UNKNOWN",
          "title": "Conflicting Authoritative",
          "type": "string"
        },
        "correction": {
          "const": "latest_revision_known_at_snapshot",
          "title": "Correction",
          "type": "string"
        },
        "duplicate_different_content": {
          "const": "SOURCE_CONFLICT",
          "title": "Duplicate Different Content",
          "type": "string"
        },
        "duplicate_same_content": {
          "const": "single_effect",
          "title": "Duplicate Same Content",
          "type": "string"
        },
        "failed_chain_transaction": {
          "const": "no_economic_effect",
          "title": "Failed Chain Transaction",
          "type": "string"
        },
        "retraction_without_replacement": {
          "const": "UNKNOWN_LOSS_OF_SUPPORT",
          "title": "Retraction Without Replacement",
          "type": "string"
        },
        "technical_error": {
          "const": "UNKNOWN",
          "title": "Technical Error",
          "type": "string"
        }
      },
      "required": [
        "absent",
        "conflicting_authoritative",
        "correction",
        "retraction_without_replacement",
        "duplicate_same_content",
        "duplicate_different_content",
        "failed_chain_transaction",
        "technical_error"
      ],
      "title": "EvidencePolicy",
      "type": "object"
    },
    "InstrumentRef": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "instrument_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "scale": {
          "maximum": 38,
          "minimum": 0,
          "title": "Scale",
          "type": "integer"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "unit": {
          "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "unit",
        "scale",
        "description",
        "synthetic"
      ],
      "title": "InstrumentRef",
      "type": "object"
    },
    "Pricing": {
      "additionalProperties": false,
      "properties": {
        "cash_scale": {
          "maximum": 38,
          "minimum": 0,
          "title": "Cash Scale",
          "type": "integer"
        },
        "cash_unit": {
          "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
          "title": "Cash Unit",
          "type": "string"
        },
        "fees": {
          "const": "none",
          "title": "Fees",
          "type": "string"
        },
        "price_per_unit": {
          "$ref": "#/$defs/Quantity"
        },
        "rounding": {
          "const": "reject",
          "title": "Rounding",
          "type": "string"
        },
        "tolerance": {
          "const": "none",
          "title": "Tolerance",
          "type": "string"
        }
      },
      "required": [
        "cash_unit",
        "cash_scale",
        "price_per_unit",
        "fees",
        "rounding",
        "tolerance"
      ],
      "title": "Pricing",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "``{\"atoms\": \"1000000000\", \"scale\": 7, \"unit\": \"FUND_SHARE\"}`` is 100 shares.",
      "properties": {
        "atoms": {
          "maxLength": 79,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "title": "Atoms",
          "type": "string"
        },
        "scale": {
          "maximum": 38,
          "minimum": 0,
          "title": "Scale",
          "type": "integer"
        },
        "unit": {
          "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "atoms",
        "scale",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "QuarantinePolicy": {
      "additionalProperties": false,
      "description": "What a quarantined record of the chain coverage can and cannot do (profiles\nfund-subscription-testnet@1.2.0 and fund-redemption-synthetic@1.5.0 on).\n\nDeclared explicitly so that ``quarantined_records_allowed: false`` keeps the meaning it\nhad in the profiles that predate this policy, where a quarantined record bearing on the\noperation blocks every comparison of its source:\n\n- ``evidence``: a quarantined record never credits fulfilment;\n- ``blocking``: its existence makes UNKNOWN only the controls whose conclusion resolving\n  it could change; a control it cannot change is not blocked automatically;\n- ``certificates``: a quarantine stays active until a later certificate of the same chain\n  scope, including its route and ledger range, explicitly supersedes it; the absence of\n  a record in a certificate of another scope resolves nothing;\n- ``classification``: a record's ``nature`` and ``chain_operation`` are relied on to set\n  a record aside only when the snapshot's own artifacts support them;\n- ``unapproved_parties``: a party that cannot be or is not approved for the account\n  (a contract, an account without IdentityLink) is not thereby foreign; an effect or\n  record naming only such parties is outside the declared scope unless an\n  ExecutionLink, an explicit association or an unresolved participant brings it in.",
      "properties": {
        "blocking": {
          "const": "only_controls_whose_conclusion_it_could_change",
          "title": "Blocking",
          "type": "string"
        },
        "certificates": {
          "const": "active_until_explicit_supersession_within_chain_scope",
          "title": "Certificates",
          "type": "string"
        },
        "classification": {
          "const": "relied_on_only_when_supported_by_the_snapshot",
          "title": "Classification",
          "type": "string"
        },
        "evidence": {
          "const": "never_credits_fulfilment",
          "title": "Evidence",
          "type": "string"
        },
        "unapproved_parties": {
          "const": "outside_declared_scope_unless_linked_associated_or_unresolved",
          "title": "Unapproved Parties",
          "type": "string"
        }
      },
      "required": [
        "evidence",
        "blocking",
        "certificates",
        "classification",
        "unapproved_parties"
      ],
      "title": "QuarantinePolicy",
      "type": "object"
    },
    "SourceAuthority": {
      "additionalProperties": false,
      "description": "Authority is per fact type. No source is a universal source of truth.\n\n``mapping_ref`` is the mapping of the source's authoritative records;\n``additional_mapping_refs`` (fund-subscription-testnet@1.4.0 on) are the other mappings\nthe profile admits for this source (a chain source also writes chain effects and the\nmovements only one route reads). A new evaluation is refused when an observation of a\ndeclared source was produced by a mapping the profile does not admit for it: it is\nnever relabelled nor read as if another mapping had produced it. Absent,\nthe source admits only ``mapping_ref``; it is omitted when serialized, so existing\nprofiles stay byte-identical.",
      "properties": {
        "additional_mapping_refs": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Additional Mapping Refs"
        },
        "authoritative_for": {
          "items": {
            "enum": [
              "order_accepted",
              "cash_settled",
              "units_registered",
              "token_movement",
              "redemption_accepted",
              "redemption_cancelled",
              "position_held",
              "price_approved",
              "position_changed",
              "redemption_reactivated",
              "chain_effect"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Authoritative For",
          "type": "array"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "order_management",
            "bank",
            "transfer_agent",
            "stellar_ledger",
            "pricing_agent"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mapping_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Mapping Ref",
          "type": "string"
        },
        "parser_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Parser Ref",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "kind",
        "authoritative_for",
        "mapping_ref",
        "parser_ref",
        "description"
      ],
      "title": "SourceAuthority",
      "type": "object"
    },
    "StellarClassicRepresentation": {
      "additionalProperties": false,
      "description": "A Stellar Classic asset: network + asset code + issuer.\n\nClassic amounts carry 7 decimals. Access through the Stellar Asset Contract (SAC) is\nthe same underlying asset and must never be counted as a second issuance; the\nfirst synthetic profile does not ingest SAC events at all (declared unsupported).",
      "properties": {
        "amount_scale": {
          "const": 7,
          "title": "Amount Scale",
          "type": "integer"
        },
        "asset_code": {
          "pattern": "^[A-Za-z0-9]{1,12}$",
          "title": "Asset Code",
          "type": "string"
        },
        "instrument_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "issuer": {
          "title": "Issuer",
          "type": "string"
        },
        "network": {
          "enum": [
            "stellar:testnet",
            "stellar:pubnet"
          ],
          "title": "Network",
          "type": "string"
        },
        "network_passphrase": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Network Passphrase",
          "type": "string"
        },
        "representation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Representation Id",
          "type": "string"
        },
        "standard": {
          "const": "stellar_classic",
          "title": "Standard",
          "type": "string"
        }
      },
      "required": [
        "representation_id",
        "instrument_id",
        "standard",
        "network",
        "network_passphrase",
        "asset_code",
        "issuer",
        "amount_scale"
      ],
      "title": "StellarClassicRepresentation",
      "type": "object"
    }
  },
  "$id": "urn:invaria:schema:operation-profile:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "controls": {
      "items": {
        "$ref": "#/$defs/ControlSpec"
      },
      "minItems": 1,
      "title": "Controls",
      "type": "array"
    },
    "correlation": {
      "$ref": "#/$defs/Correlation"
    },
    "coverage_requirements": {
      "items": {
        "$ref": "#/$defs/CoverageRequirement"
      },
      "title": "Coverage Requirements",
      "type": "array"
    },
    "disclaimer": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Disclaimer",
      "type": "string"
    },
    "evidence_policy": {
      "$ref": "#/$defs/EvidencePolicy"
    },
    "instrument": {
      "$ref": "#/$defs/InstrumentRef"
    },
    "operation_type": {
      "const": "subscription",
      "title": "Operation Type",
      "type": "string"
    },
    "pricing": {
      "$ref": "#/$defs/Pricing"
    },
    "profile_ref": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Profile Ref",
      "type": "string"
    },
    "representation_ratio": {
      "const": "1:1",
      "title": "Representation Ratio",
      "type": "string"
    },
    "representations": {
      "items": {
        "$ref": "#/$defs/StellarClassicRepresentation"
      },
      "minItems": 1,
      "title": "Representations",
      "type": "array"
    },
    "result_precedence": {
      "const": "BREAK>UNKNOWN>MATCH",
      "title": "Result Precedence",
      "type": "string"
    },
    "rules_ref": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Rules Ref",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceAuthority"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "unsupported": {
      "items": {
        "enum": [
          "fees",
          "partial_fill",
          "multiple_cash_payments",
          "variable_nav",
          "fx_conversion",
          "rounding",
          "omnibus_account",
          "distributor_delivery",
          "sac_events",
          "soroban_custom_token",
          "redemption",
          "amount_time_matching"
        ],
        "type": "string"
      },
      "title": "Unsupported",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "profile_ref",
    "operation_type",
    "synthetic",
    "disclaimer",
    "instrument",
    "representations",
    "representation_ratio",
    "pricing",
    "correlation",
    "sources",
    "coverage_requirements",
    "controls",
    "rules_ref",
    "result_precedence",
    "evidence_policy",
    "unsupported"
  ],
  "title": "OperationProfile",
  "type": "object"
}
