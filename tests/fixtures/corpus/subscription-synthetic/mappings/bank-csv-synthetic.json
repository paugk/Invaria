      "kind": "identifier",
      "column": "account_ref"
    },
    "payment_ref": {
      "kind": "identifier",
      "column": "payment_ref"
    },
    "amount": {
      "kind": "quantity",
      "column": "amount",
      "unit": "USD",
      "unit_column": "currency",
      "scale": 2,
      "decimals": "exact",
      "sign": "non_negative"
    }
  }
}
