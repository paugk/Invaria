{
  "$defs": {
    "CancellationPolicy": {
      "additionalProperties": false,
      "properties": {
        "authorized_by": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Authorized By",
          "type": "array"
        },
        "automatic_reversal": {
          "const": false,
          "title": "Automatic Reversal",
          "type": "boolean"
        },
        "contradictory_association": {
          "const": "UNKNOWN_keep_conflict",
          "title": "Contradictory Association",
          "type": "string"
        },
        "effect": {
          "const": "extinguishes_pending_settlement_obligations",
          "title": "Effect",
          "type": "string"
        },
        "effective_after_due": {
          "const": "keeps_a_demonstrated_breach",
          "title": "Effective After Due",
          "type": "string"
        },
        "evidence_retraction": {
          "const": "not_a_cancellation",
          "title": "Evidence Retraction",
          "type": "string"
        },
        "foreign_cancellation": {
          "const": "out_of_scope",
          "title": "Foreign Cancellation",
          "type": "string"
        },
        "invalid_retraction": {
          "const": "UNKNOWN_INVALID_RETRACTION_keep_both",
          "title": "Invalid Retraction",
          "type": "string"
        },
        "reactivation": {
          "const": "UNKNOWN_unsupported",
          "title": "Reactivation",
          "type": "string"
        },
        "request_retraction": {
          "const": "LOSS_OF_SUPPORT_in_dependent_controls_only",
          "title": "Request Retraction",
          "type": "string"
        },
        "retracted_cancellation": {
          "const": "no_cancellation_in_force_with_ta_coverage",
          "title": "Retracted Cancellation",
          "type": "string"
        },
        "settlement_despite_cancellation": {
          "const": "BREAK_review_required",
          "title": "Settlement Despite Cancellation",
          "type": "string"
        },
        "valid_when": {
          "const": "effective_at_or_after_acceptance",
          "title": "Valid When",
          "type": "string"
        }
      },
      "required": [
        "authorized_by",
        "valid_when",
        "effect",
        "settlement_despite_cancellation",
        "automatic_reversal",
        "evidence_retraction",
        "effective_after_due",
        "retracted_cancellation",
        "reactivation",
        "foreign_cancellation",
        "contradictory_association",
        "request_retraction",
        "invalid_retraction"
      ],
      "title": "CancellationPolicy",
      "type": "object"
    },
    "EvidencePolicy": {
