{
  "$defs": {
    "ConclusionChangeView": {
      "additionalProperties": false,
      "properties": {
        "added_evidence": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Added Evidence",
          "type": "array"
        },
        "changed_controls": {
          "items": {
            "$ref": "#/$defs/ControlChangeView"
          },
          "title": "Changed Controls",
          "type": "array"
        },
        "from_result": {
          "enum": [
            "MATCH",
            "BREAK",
            "UNKNOWN"
          ],
          "title": "From Result",
          "type": "string"
        },
        "limitations": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "new_evaluation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "New Evaluation Id",
          "type": "string"
        },
        "new_known_at": {
          "format": "date-time",
          "title": "New Known At",
          "type": "string"
        },
        "old_evaluation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Old Evaluation Id",
          "type": "string"
        },
        "old_known_at": {
          "format": "date-time",
          "title": "Old Known At",
          "type": "string"
        },
        "removed_evidence": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Removed Evidence",
          "type": "array"
        },
        "replay_consistent": {
          "title": "Replay Consistent",
          "type": "boolean"
        },
        "to_result": {
          "enum": [
            "MATCH",
            "BREAK",
            "UNKNOWN"
          ],
          "title": "To Result",
          "type": "string"
        }
      },
      "required": [
        "old_evaluation_id",
        "new_evaluation_id",
        "from_result",
        "to_result",
        "old_known_at",
        "new_known_at",
        "changed_controls",
        "added_evidence",
        "removed_evidence",
        "replay_consistent",
        "limitations"
      ],
      "title": "ConclusionChangeView",
      "type": "object"
    },
    "ConclusionView": {
      "additionalProperties": false,
      "properties": {
        "controls": {
          "items": {
            "$ref": "#/$defs/ControlView"
          },
          "title": "Controls",
          "type": "array"
        },
        "coverage": {
          "items": {
            "$ref": "#/$defs/CoverageView"
          },
          "title": "Coverage",
          "type": "array"
        },
        "currency": {
          "$ref": "#/$defs/CurrencyView"
        },
        "evaluation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "operation_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Operation Ref",
          "type": "string"
        },
        "operation_state": {
          "anyOf": [
            {
              "const": "cancelled",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Operation State"
        },
        "result": {
          "enum": [
            "MATCH",
            "BREAK",
            "UNKNOWN"
          ],
          "title": "Result",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/SnapshotView"
        },
        "versions": {
          "$ref": "#/$defs/VersionsView"
        }
      },
      "required": [
        "evaluation_id",
        "operation_ref",
        "result",
        "operation_state",
        "snapshot",
        "currency",
        "controls",
        "coverage",
        "versions",
        "limitations"
      ],
      "title": "ConclusionView",
      "type": "object"
    },
    "ControlChangeView": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "After",
          "type": "string"
        },
        "before": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Before",
          "type": "string"
        },
        "control_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        }
      },
      "required": [
        "control_id",
        "before",
        "after"
      ],
      "title": "ControlChangeView",
      "type": "object"
    },
    "ControlComparison": {
      "additionalProperties": false,
      "properties": {
        "changed": {
          "title": "Changed",
          "type": "boolean"
        },
        "control_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "left_status": {
          "anyOf": [
            {
              "enum": [
                "PASS",
                "FAIL",
                "UNKNOWN",
                "NOT_APPLICABLE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Left Status"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "right_status": {
          "anyOf": [
            {
              "enum": [
                "PASS",
                "FAIL",
                "UNKNOWN",
                "NOT_APPLICABLE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Right Status"
        }
      },
      "required": [
        "control_id",
        "mandatory",
        "left_status",
        "right_status",
        "changed"
      ],
      "title": "ControlComparison",
      "type": "object"
    },
    "ControlView": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Evidence Refs",
          "type": "array"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "EXACT_MATCH",
            "CASH_AMOUNT_MISMATCH",
            "UNITS_MISMATCH",
            "ORDER_TERMS_INCONSISTENT",
            "MISSING_EVIDENCE",
            "INSUFFICIENT_COVERAGE",
            "LOSS_OF_SUPPORT",
            "SOURCE_CONFLICT",
            "AMBIGUOUS_MATCH",
            "QUARANTINED_INPUT",
            "UNSUPPORTED_CAPABILITY",
            "EVALUATION_ERROR",
            "NOT_APPLICABLE_BY_PROFILE",
            "PRICE_MISMATCH",
            "UNITS_EXCEED_POSITION",
            "PAYMENT_LATE",
            "PAYMENT_MISSED",
            "SETTLED_DESPITE_CANCELLATION",
            "INEXACT_AMOUNT",
            "PAYMENT_NOT_DUE",
            "INVALID_CANCELLATION",
            "EXTINGUISHED_BY_CANCELLATION",
            "NO_CANCELLATION",
            "DEADLINE_DATA_CONFLICT",
            "BURN_BEFORE_ACCEPTANCE_UNSUPPORTED",
            "AMBIGUOUS_SEQUENCE",
            "POSITION_NOT_BEFORE_ACCEPTANCE",
            "REACTIVATION_UNSUPPORTED",
            "PAYMENT_TO_WRONG_ACCOUNT",
            "INVALID_RETRACTION"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "control_id",
        "mandatory",
        "status",
        "reason_code",
        "reason",
        "delta",
        "evidence_refs"
      ],
      "title": "ControlView",
      "type": "object"
    },
    "CoverageView": {
      "additionalProperties": false,
      "properties": {
        "coverage_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Coverage Id",
          "type": "string"
        },
        "fact_types": {
          "items": {
            "enum": [
              "order_accepted",
              "cash_settled",
              "units_registered",
              "token_movement",
              "redemption_accepted",
              "redemption_cancelled",
              "position_held",
              "price_approved",
              "position_changed",
              "redemption_reactivated",
              "chain_effect"
            ],
            "type": "string"
          },
          "title": "Fact Types",
          "type": "array"
        },
        "gaps": {
          "title": "Gaps",
          "type": "integer"
        },
        "interval": {
          "$ref": "#/$defs/TimeInterval"
        },
        "level": {
          "enum": [
            "provider_claimed",
            "internally_checked",
            "independently_verified"
          ],
          "title": "Level",
          "type": "string"
        },
        "meets_required_level": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Meets Required Level"
        },
        "records_quarantined": {
          "title": "Records Quarantined",
          "type": "integer"
        },
        "records_received": {
          "title": "Records Received",
          "type": "integer"
        },
        "required_level": {
          "anyOf": [
            {
              "enum": [
                "provider_claimed",
                "internally_checked",
                "independently_verified"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Required Level"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "coverage_id",
        "source_id",
        "fact_types",
        "level",
        "required_level",
        "meets_required_level",
        "interval",
        "gaps",
        "records_received",
        "records_quarantined"
      ],
      "title": "CoverageView",
      "type": "object"
    },
    "CurrencyView": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "enum": [
            "current",
            "stale",
            "superseded",
            "not_published"
          ],
          "title": "Currency",
          "type": "string"
        },
        "published_epoch": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published Epoch"
        },
        "scope_epoch": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope Epoch"
        }
      },
      "required": [
        "currency",
        "scope_epoch",
        "published_epoch"
      ],
      "title": "CurrencyView",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "``{\"atoms\": \"1000000000\", \"scale\": 7, \"unit\": \"FUND_SHARE\"}`` is 100 shares.",
      "properties": {
        "atoms": {
          "maxLength": 79,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "title": "Atoms",
          "type": "string"
        },
        "scale": {
          "maximum": 38,
          "minimum": 0,
          "title": "Scale",
          "type": "integer"
        },
        "unit": {
          "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "atoms",
        "scale",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "SnapshotView": {
      "additionalProperties": false,
      "properties": {
        "evaluation_clock": {
          "format": "date-time",
          "title": "Evaluation Clock",
          "type": "string"
        },
        "known_at": {
          "format": "date-time",
          "title": "Known At",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "valid_at": {
          "format": "date-time",
          "title": "Valid At",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "valid_at",
        "known_at",
        "evaluation_clock"
      ],
      "title": "SnapshotView",
      "type": "object"
    },
    "TimeInterval": {
      "additionalProperties": false,
      "description": "Half-open interval [start, end) in UTC.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeInterval",
      "type": "object"
    },
    "VersionsView": {
      "additionalProperties": false,
      "properties": {
        "engine_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Engine Ref",
          "type": "string"
        },
        "engine_status": {
          "enum": [
            "current",
            "retired",
            "blocked",
            "unknown"
          ],
          "title": "Engine Status",
          "type": "string"
        },
        "profile_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Profile Ref",
          "type": "string"
        },
        "rules_ref": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Rules Ref",
          "type": "string"
        }
      },
      "required": [
        "profile_ref",
        "rules_ref",
        "engine_ref",
        "engine_status"
      ],
      "title": "VersionsView",
      "type": "object"
    }
  },
  "$id": "urn:invaria:schema:query-comparison:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "change": {
      "$ref": "#/$defs/ConclusionChangeView"
    },
    "controls": {
      "items": {
        "$ref": "#/$defs/ControlComparison"
      },
      "title": "Controls",
      "type": "array"
    },
    "left": {
      "$ref": "#/$defs/ConclusionView"
    },
    "right": {
      "$ref": "#/$defs/ConclusionView"
    }
  },
  "required": [
    "left",
    "right",
    "controls",
    "change"
  ],
  "title": "ComparisonView",
  "type": "object"
}
