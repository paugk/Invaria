{
  "$defs": {
    "AgeView": {
      "additionalProperties": false,
      "description": "Knowledge-time distance from the snapshot known_at of the run's first publication to\nthe report's evidence horizon. Not time since publication, not the age of the evidence,\nnot time open. ``published_run_start`` (definition 1.0.0) crossed unpublished epochs;\n``contiguous_fail_run_start`` (1.1.0) stops at them and at a change of engine.",
      "properties": {
        "age_reference": {
          "anyOf": [
            {
              "const": "evidence_horizon",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Reference"
        },
        "age_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Age Seconds"
        },
        "age_undetermined_reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Undetermined Reason"
        },
        "basis": {
          "enum": [
            "published_run_start",
            "contiguous_fail_run_start"
          ],
          "title": "Basis",
          "type": "string"
        },
        "epochs_without_publication_in_run": {
          "items": {
            "type": "integer"
          },
          "title": "Epochs Without Publication In Run",
          "type": "array"
        },
        "origin_evaluation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Origin Evaluation Id",
          "type": "string"
        },
        "origin_known_at": {
          "format": "date-time",
          "title": "Origin Known At",
          "type": "string"
        },
        "publications_in_run": {
          "title": "Publications In Run",
          "type": "integer"
        },
        "run_stopped_by": {
          "enum": [
            "earlier_publication_not_fail",
            "profile_changed",
            "engine_changed",
            "unpublished_epoch_gap",
            "earlier_publication_after_cut",
            "no_earlier_publication"
          ],
          "title": "Run Stopped By",
          "type": "string"
        },
        "unpublished_epochs_before_run": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unpublished Epochs Before Run"
        }
      },
      "required": [
        "basis",
        "origin_evaluation_id",
        "origin_known_at",
        "age_seconds",
        "publications_in_run",
        "epochs_without_publication_in_run",
        "run_stopped_by"
      ],
      "title": "AgeView",
      "type": "object"
    },
    "BlockGroup": {
      "additionalProperties": false,
      "properties": {
        "cases_key": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Cases Key",
          "type": "string"
        },
        "category": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "operations": {
          "title": "Operations",
          "type": "integer"
        },
        "requirements": {
          "title": "Requirements",
          "type": "integer"
        }
      },
      "required": [
        "category",
        "operations",
        "requirements",
        "cases_key"
      ],
      "title": "BlockGroup",
      "type": "object"
    },
    "BlockRecord": {
      "additionalProperties": false,
      "description": "The undetermined check that fixed an UNKNOWN control's result.",
      "properties": {
        "category": {
          "anyOf": [
            {
              "enum": [
                "missing_evidence",
                "withdrawn_evidence",
                "source_conflict",
                "inconsistent_evidence",
                "invalid_evidence",
                "insufficient_coverage",
                "quarantined_input",
                "unattributed",
                "unsupported_capability",
                "not_yet_due",
                "technical_error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Category"
        },
        "control_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "coverage_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Coverage Ids",
          "type": "array"
        },
        "evaluation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Evidence Refs",
          "type": "array"
        },
        "fact_type": {
          "anyOf": [
            {
              "enum": [
                "order_accepted",
                "cash_settled",
                "units_registered",
                "token_movement",
                "redemption_accepted",
                "redemption_cancelled",
                "position_held",
                "price_approved",
                "position_changed",
                "redemption_reactivated",
                "chain_effect"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fact Type"
        },
        "operation_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Operation Ref",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "EXACT_MATCH",
                "CASH_AMOUNT_MISMATCH",
                "UNITS_MISMATCH",
                "ORDER_TERMS_INCONSISTENT",
                "MISSING_EVIDENCE",
                "INSUFFICIENT_COVERAGE",
                "LOSS_OF_SUPPORT",
                "SOURCE_CONFLICT",
                "AMBIGUOUS_MATCH",
                "QUARANTINED_INPUT",
                "UNSUPPORTED_CAPABILITY",
                "EVALUATION_ERROR",
                "NOT_APPLICABLE_BY_PROFILE",
                "PRICE_MISMATCH",
                "UNITS_EXCEED_POSITION",
                "PAYMENT_LATE",
                "PAYMENT_MISSED",
                "SETTLED_DESPITE_CANCELLATION",
                "INEXACT_AMOUNT",
                "PAYMENT_NOT_DUE",
                "INVALID_CANCELLATION",
                "EXTINGUISHED_BY_CANCELLATION",
                "NO_CANCELLATION",
                "DEADLINE_DATA_CONFLICT",
                "BURN_BEFORE_ACCEPTANCE_UNSUPPORTED",
                "AMBIGUOUS_SEQUENCE",
                "POSITION_NOT_BEFORE_ACCEPTANCE",
                "REACTIVATION_UNSUPPORTED",
                "PAYMENT_TO_WRONG_ACCOUNT",
                "INVALID_RETRACTION"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "required_from_source": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Required From Source"
        },
        "requirement_id": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        }
      },
      "required": [
        "operation_ref",
        "evaluation_id",
        "control_id",
        "requirement_id",
        "category",
        "reason_code",
        "fact_type",
        "required_from_source",
        "evidence_refs",
        "coverage_ids"
      ],
      "title": "BlockRecord",
      "type": "object"
    },
    "BlockersView": {
      "additionalProperties": false,
      "properties": {
        "blocked_requirements": {
          "title": "Blocked Requirements",
          "type": "integer"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/BlockRecord"
          },
          "title": "Blocks",
          "type": "array"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "diagnosis_unavailable": {
          "items": {
            "$ref": "#/$defs/ControlRef"
          },
          "title": "Diagnosis Unavailable",
          "type": "array"
        },
        "evaluations_requiring_diagnosis": {
          "title": "Evaluations Requiring Diagnosis",
          "type": "integer"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/BlockGroup"
          },
          "title": "Groups",
          "type": "array"
        },
        "max_replays": {
          "title": "Max Replays",
          "type": "integer"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricView"
          },
          "title": "Metrics",
          "type": "array"
        },
        "not_evaluated": {
          "items": {
            "$ref": "#/$defs/ControlRef"
          },
          "title": "Not Evaluated",
          "type": "array"
        },
        "not_processed": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Not Processed",
          "type": "array"
        },
        "operations_with_block": {
          "title": "Operations With Block",
          "type": "integer"
        },
        "reconstruction_mismatch": {
          "items": {
            "$ref": "#/$defs/ControlRef"
          },
          "title": "Reconstruction Mismatch",
          "type": "array"
        },
        "replayed": {
          "title": "Replayed",
          "type": "integer"
        }
      },
      "required": [
        "complete",
        "max_replays",
        "evaluations_requiring_diagnosis",
        "replayed",
        "not_processed",
        "operations_with_block",
        "blocked_requirements",
        "groups",
        "blocks",
        "not_evaluated",
        "diagnosis_unavailable",
        "reconstruction_mismatch",
        "metrics"
      ],
      "title": "BlockersView",
      "type": "object"
    },
    "ControlRef": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Control Id",
          "type": "string"
        },
        "evaluation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "operation_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Operation Ref",
          "type": "string"
        },
        "requirement_id": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Requirement Id"
        }
      },
      "required": [
        "operation_ref",
        "evaluation_id",
        "control_id",
        "requirement_id"
      ],
      "title": "ControlRef",
      "type": "object"
    },
    "DiscrepanciesView": {
      "additionalProperties": false,
      "properties": {
        "control_discrepancies": {
          "title": "Control Discrepancies",
          "type": "integer"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/DiscrepancyGroup"
          },
          "title": "Groups",
          "type": "array"
        },
        "incidents": {
          "items": {
            "$ref": "#/$defs/DiscrepancyIncident"
          },
          "title": "Incidents",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricView"
          },
          "title": "Metrics",
          "type": "array"
        },
        "operations_with_discrepancy": {
          "title": "Operations With Discrepancy",
          "type": "integer"
        }
      },
      "required": [
        "operations_with_discrepancy",
        "control_discrepancies",
        "groups",
        "incidents",
        "metrics"
      ],
      "title": "DiscrepanciesView",
      "type": "object"
    },
    "DiscrepancyGroup": {
      "additionalProperties": false,
      "properties": {
        "cases_key": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Cases Key",
