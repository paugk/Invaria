            ],
            "type": "string"
          },
          "title": "Failure Codes",
          "type": "array"
        },
        "left": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Left",
          "type": "string"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "requires": {
          "items": {
            "enum": [
              "order_accepted",
              "cash_settled",
              "units_registered",
              "token_movement",
              "redemption_accepted",
              "redemption_cancelled",
              "position_held",
              "price_approved",
              "position_changed",
              "redemption_reactivated",
              "chain_effect"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Requires",
          "type": "array"
        },
        "right": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Right",
          "type": "string"
        }
      },
      "required": [
        "control_id",
        "mandatory",
        "requires",
        "comparison",
        "applies",
        "coverage",
        "left",
        "right",
        "failure_codes"
      ],
      "title": "RedemptionControlSpec",
      "type": "object"
    },
