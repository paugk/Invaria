{
  "$defs": {
    "CoverageCertificate": {
      "additionalProperties": false,
      "properties": {
        "coverage_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Coverage Id",
          "type": "string"
        },
        "fact_types": {
          "items": {
            "enum": [
              "order_accepted",
              "cash_settled",
              "units_registered",
              "token_movement"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Types",
          "type": "array"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/TimeInterval"
          },
          "title": "Gaps",
          "type": "array"
        },
        "instrument_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Instrument Id",
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/TimeInterval"
        },
        "ledger_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/LedgerRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "level": {
          "enum": [
            "provider_claimed",
            "internally_checked",
            "independently_verified"
          ],
          "title": "Level",
          "type": "string"
        },
        "method": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "raw_sha256": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Raw Sha256",
          "type": "array"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "records_quarantined": {
          "minimum": 0,
          "title": "Records Quarantined",
          "type": "integer"
        },
        "records_received": {
          "minimum": 0,
          "title": "Records Received",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "tenant_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "coverage_id",
        "tenant_id",
        "source_id",
        "fact_types",
        "instrument_id",
        "interval",
        "ledger_range",
        "level",
        "method",
        "records_received",
        "records_quarantined",
        "gaps",
        "raw_sha256",
        "recorded_at",
        "synthetic"
      ],
      "title": "CoverageCertificate",
      "type": "object"
    },
    "LedgerRange": {
      "additionalProperties": false,
      "properties": {
        "first": {
          "minimum": 1,
          "title": "First",
          "type": "integer"
        },
        "last": {
          "minimum": 1,
          "title": "Last",
          "type": "integer"
        }
      },
      "required": [
        "first",
        "last"
      ],
      "title": "LedgerRange",
      "type": "object"
    },
    "TimeInterval": {
      "additionalProperties": false,
      "description": "Half-open interval [start, end) in UTC.",
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeInterval",
      "type": "object"
    }
  },
  "$id": "urn:invaria:schema:coverage-set:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "certificates": {
      "items": {
        "$ref": "#/$defs/CoverageCertificate"
      },
      "minItems": 1,
      "title": "Certificates",
      "type": "array"
    },
    "corpus_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Corpus Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "corpus_id",
    "synthetic",
    "certificates"
  ],
  "title": "CoverageSet",
  "type": "object"
}
