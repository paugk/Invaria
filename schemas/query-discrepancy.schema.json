{
  "$defs": {
    "CurrencyView": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "enum": [
            "current",
            "stale",
            "superseded",
            "not_published"
          ],
          "title": "Currency",
          "type": "string"
        },
        "published_epoch": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published Epoch"
        },
        "scope_epoch": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope Epoch"
        }
      },
      "required": [
        "currency",
        "scope_epoch",
        "published_epoch"
      ],
      "title": "CurrencyView",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "``{\"atoms\": \"1000000000\", \"scale\": 7, \"unit\": \"FUND_SHARE\"}`` is 100 shares.",
      "properties": {
        "atoms": {
          "maxLength": 79,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "title": "Atoms",
          "type": "string"
        },
        "scale": {
          "maximum": 38,
          "minimum": 0,
          "title": "Scale",
          "type": "integer"
        },
        "unit": {
          "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "atoms",
        "scale",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "SnapshotView": {
      "additionalProperties": false,
      "properties": {
        "evaluation_clock": {
          "format": "date-time",
          "title": "Evaluation Clock",
          "type": "string"
        },
        "known_at": {
          "format": "date-time",
          "title": "Known At",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "valid_at": {
          "format": "date-time",
          "title": "Valid At",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "valid_at",
        "known_at",
        "evaluation_clock"
      ],
      "title": "SnapshotView",
      "type": "object"
    }
  },
  "$id": "urn:invaria:schema:query-discrepancy:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "control_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Control Id",
      "type": "string"
    },
    "currency": {
      "$ref": "#/$defs/CurrencyView"
    },
    "delta": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Evaluation Id",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Evidence Refs",
      "type": "array"
    },
    "left": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ]
    },
    "left_definition": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Left Definition",
      "type": "string"
    },
    "reason_code": {
      "enum": [
        "EXACT_MATCH",
        "CASH_AMOUNT_MISMATCH",
        "UNITS_MISMATCH",
        "ORDER_TERMS_INCONSISTENT",
        "MISSING_EVIDENCE",
        "INSUFFICIENT_COVERAGE",
        "LOSS_OF_SUPPORT",
        "SOURCE_CONFLICT",
        "AMBIGUOUS_MATCH",
        "QUARANTINED_INPUT",
        "UNSUPPORTED_CAPABILITY",
        "EVALUATION_ERROR",
        "NOT_APPLICABLE_BY_PROFILE"
      ],
      "title": "Reason Code",
      "type": "string"
    },
    "replay_consistent": {
      "title": "Replay Consistent",
      "type": "boolean"
    },
    "right": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ]
    },
    "right_definition": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Right Definition",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/SnapshotView"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "evaluation_id",
    "control_id",
    "status",
    "reason_code",
    "left_definition",
    "right_definition",
    "left",
    "right",
    "delta",
    "evidence_refs",
    "replay_consistent",
    "snapshot",
    "currency"
  ],
  "title": "DiscrepancyView",
  "type": "object"
}
